{
  "name": "vaccination-backend",
  "version": "1.0.0",
  "description": "Backend del sistema de gestión de campañas de vacunación",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
